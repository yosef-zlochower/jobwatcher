#!/bin/bash
# fakecactus - imitates the parts of Cactus that jw_job.sh relies on.
#   - reads IO::recover_dir, cactus::cctk_itlast, cactus::max_runtime and IO::out_dir from the parfile
#   - "recovers" from the newest checkpoint in the recover dir
#   - advances FAKE_STEP iterations (default 500), capped at cctk_itlast
#   - writes checkpoint.chkpt.it_<N>.file_0.h5 and prints the CarpetIOHDF5 termination lines
# Environment knobs: FAKE_CRASH=1 (exit 1, no termination checkpoint), FAKE_STEP=<n>,
#                    FAKE_NOCHECKPOINT=1 (print the line but write no file).
par=${1:?parfile}
getp() { grep -iE "^[[:space:]]*$1[[:space:]]*=" "$par" | tail -n1 | sed -e 's/#.*//' -e 's/^[^=]*=[[:space:]]*//' -e 's/"//g' -e 's/[[:space:]]*$//'; }
ckdir=$(getp 'IO::recover_dir'); itlast=$(getp 'cactus::cctk_itlast'); maxrt=$(getp 'cactus::max_runtime')
outdir=$(getp 'IO::out_dir'); [ "$outdir" = '$parfile' ] && outdir=${par%.par}
mkdir -p "$outdir"
cat <<EOT
--------------------------------------------------------------------------------
       10
  1   0101       ************************
  01  1010 10      The Cactus Code V4.18.0
 1010 1101 011      www.cactuscode.org
--------------------------------------------------------------------------------
Parameter file:    $par
INFO (Cactus): max_runtime = $maxrt minutes, cctk_itlast = ${itlast:-unset}
EOT
last=$(ls "$ckdir"/*.chkpt.it_*.h5 2>/dev/null | sed -n 's/.*\.it_\([0-9]*\)\..*/\1/p' | sort -n | tail -n1)
if [ -n "$last" ]; then echo "INFO (CarpetIOHDF5): recovering from checkpoint at iteration $last"; else last=0; fi
step=${FAKE_STEP:-500}
new=$(( last + step ))
# Cactus termination semantics (defaults: terminate=iteration, cctk_itlast=10, cctk_final_time=-1).
mode=$(getp 'cactus::terminate' | tr 'A-Z' 'a-z'); mode=${mode:-iteration}
itlast=${itlast:-10}; ftime=$(getp 'cactus::cctk_final_time'); ftime=${ftime:--1}
stop_at_time() { awk -v l="$last" -v f="$ftime" 'BEGIN{exit !(l*0.000678 >= f)}'; }
case $mode in
  iteration) (( new > itlast )) && new=$itlast; (( last >= itlast )) && new=$last ;;
  time)      stop_at_time && new=$last ;;
  any)       (( new > itlast )) && new=$itlast; (( last >= itlast )) && new=$last; stop_at_time && new=$last ;;
esac
for (( i = last + 1; i <= new; i += 100 )); do echo "Done with this timestep"; echo "it=$i" >> "$outdir/iterations.asc"; done
case " ${FAKE_CRASH_DIRS:-} " in *" $(basename "$PWD") "*) FAKE_CRASH=1 ;; esac
if [ "${FAKE_CRASH:-0}" = 1 ]; then
  echo "Rank 1 with PID 4242 received signal 11"; echo "Writing backtrace to $outdir/backtrace.1.txt"; exit 1
fi
t=$(awk "BEGIN{printf \"%g\", $new * 0.000678}")
echo "INFO (CarpetIOHDF5): Dumping termination checkpoint at iteration $new, simulation time $t"
echo "INFO (CarpetIOHDF5): ---------------------------------------------------------"
[ "${FAKE_NOCHECKPOINT:-0}" = 1 ] || touch "$ckdir/checkpoint.chkpt.it_$new.file_0.h5"
echo "INFO (TimerReport): Timer Report before terminating at iteration $new time $t"
echo "--------------------------------------------------------------------------------"
echo "Done."
exit 0
